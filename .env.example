# Copy to .env for local development (`npm run dev:infra` starts the infrastructure).
# All variables are validated with zod at start-up; services fail fast on bad config.

NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=local-dev-secret-change-me-please
CORS_ORIGINS=http://localhost:3700

# Infrastructure from docker-compose (host ports)
NATS_URL=nats://localhost:4722
MONGODB_URI=mongodb://localhost:27117/?directConnection=true
DATABASE_URL=postgresql://shopstream:shopstream@localhost:4710/shopstream_orders
# Neon/pgbouncer only: direct (non-pooled) URL used by `prisma migrate deploy`
# DIRECT_URL=

# Tracing (Jaeger in docker-compose); leave empty to disable
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4718

# Simulation knobs
PAYMENT_LATENCY_MS=700
FULFILLMENT_SHIP_AFTER_MS=4000
FULFILLMENT_DELIVER_AFTER_MS=8000
